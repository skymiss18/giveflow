# Network the app talks to: 31337 (local Anvil) or 11155111 (Sepolia)
NEXT_PUBLIC_CHAIN_ID=11155111
# Browser and server RPC. Use a provider key for Sepolia; defaults to the public RPC.
NEXT_PUBLIC_RPC_URL=
# Optional server-only RPC override
RPC_URL=
# Reown Dashboard Project ID: enables wallet connections and in-store Wallet APP QR.
# Allowlist deployed origins in Reown; restart dev or rebuild after changing this value.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Public HTTPS origin for website payment QR codes (defaults to the current browser origin)
NEXT_PUBLIC_APP_URL=
# Local Anvil only: shows role-based dev wallets (never set on Sepolia/production)
NEXT_PUBLIC_DEV_WALLETS=0
# 32-byte hex key that encrypts uploaded evidence files at rest
EVIDENCE_MASTER_KEY=
# Where the SQLite index and encrypted evidence live (defaults to ./.data)
DATA_DIR=
# Max blocks per eth_getLogs request (lower for providers with small limits)
LOG_CHUNK_SIZE=2000
# Gas-sponsored checkout: use a dedicated, funded key; never reuse an admin/deployer key.
RELAYER_PRIVATE_KEY=
RELAY_ALLOWED_TOKENS=
RELAY_ALLOWED_CAMPAIGNS=
RELAY_ALLOW_EXTERNAL_TOKENS=0
RELAYER_MAX_GAS=2500000
